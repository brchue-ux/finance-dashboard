# TEST ENVIRONMENT — synthetic data only. Never point this at local.db.
#
# local.db holds REAL financial data (1,700+ real RBC transactions). This file
# exists so demo/test data can be created freely without touching it. Load it
# INSTEAD of .env.local when running against the test database:
#
#   node --env-file=.env.local --env-file=.env.test ../node_modules/.bin/tsx db/seed-test.ts
#
# .env.local is loaded first for the shared secrets (auth, encryption); this
# file overrides only the database target. Both are gitignored, and *.db is
# gitignored too, so test.db can never be committed.
DATABASE_URL=file:./test.db
DATABASE_AUTH_TOKEN=

# Marked so any screen, export or log makes the environment obvious.
APP_ENV=test
SEED_EMAIL=demo@test.local
SEED_PASSWORD=test-only-not-a-real-credential
SEED_NAME=Demo (TEST DATA)
