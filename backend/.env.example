# Turso (LibSQL)
DATABASE_URL=libsql://your-db.turso.io
DATABASE_AUTH_TOKEN=your-turso-auth-token

# AES-256-GCM key — generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-32-byte-hex-key

# Better Auth
BETTER_AUTH_SECRET=your-better-auth-secret
BETTER_AUTH_URL=http://localhost:3001

# Plaid
PLAID_CLIENT_ID=your-plaid-client-id
PLAID_SECRET=your-plaid-secret
PLAID_ENV=sandbox

# SnapTrade
SNAPTRADE_CLIENT_ID=your-snaptrade-client-id
SNAPTRADE_CONSUMER_KEY=your-snaptrade-consumer-key

# TradingView webhook shared secret
TRADINGVIEW_WEBHOOK_SECRET=your-tradingview-webhook-secret

# Claude (Anthropic)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Yahoo Finance fallback
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-api-key

# Seed credentials (used once by db/seed.ts on first deploy)
SEED_EMAIL=admin@example.com
SEED_PASSWORD=change-me-before-deploying

# Public sign-up (false at launch; set true when opening Play Store)
PUBLIC_SIGNUP_ENABLED=false
